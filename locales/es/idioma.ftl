# Cambio de idioma con la bóveda abierta (docs/i18n-design.md): la oferta de traducir las
# categorías predeterminadas. Revisión: borrador por IA, sin revisión nativa.

idioma-categorias-pergunta = ¿Traducir también las categorías predeterminadas?
idioma-categorias-detalhe =
    { $n ->
        [one] Una categoría predeterminada todavía tiene el nombre en otro idioma. Las que renombraste quedan como están.
       *[other] { $n } categorías predeterminadas todavía tienen el nombre en otro idioma. Las que renombraste quedan como están.
    }
idioma-categorias-traduzir = Traducir
idioma-categorias-traduzidas =
    { $n ->
        [one] Una categoría traducida
       *[other] { $n } categorías traducidas
    }
