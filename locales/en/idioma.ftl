# Changing the language with the vault open (docs/i18n-design.md): the offer to translate the
# default categories. Revision: AI draft, not yet reviewed by a native speaker.

idioma-categorias-pergunta = Translate the default categories too?
idioma-categorias-detalhe =
    { $n ->
        [one] One default category still has its name in another language. The ones you renamed stay as they are.
       *[other] { $n } default categories still have their names in another language. The ones you renamed stay as they are.
    }
idioma-categorias-traduzir = Translate
idioma-categorias-traduzidas =
    { $n ->
        [one] One category translated
       *[other] { $n } categories translated
    }
