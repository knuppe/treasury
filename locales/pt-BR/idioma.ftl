# Troca de idioma com o cofre aberto (docs/i18n-design.md › Escolha do idioma › Depois): a oferta de
# traduzir as categorias padrão. pt-BR é o idioma de origem.

idioma-categorias-pergunta = Traduzir também as categorias padrão?
idioma-categorias-detalhe =
    { $n ->
        [1] Uma categoria padrão ainda está com o nome em outro idioma. As que você renomeou ficam como estão.
       *[other] { $n } categorias padrão ainda estão com o nome em outro idioma. As que você renomeou ficam como estão.
    }
idioma-categorias-traduzir = Traduzir
idioma-categorias-traduzidas =
    { $n ->
        [1] Uma categoria traduzida
       *[other] { $n } categorias traduzidas
    }
