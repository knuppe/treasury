{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Permissões da interface do app: só a webview `main`. Qualquer outra webview não recebe nenhuma permissão (nem comandos do app, nem plugins); páginas remotas também não (sem `remote`).",
  "webviews": ["main"],
  "local": true,
  "permissions": [
    "core:default",
    "dialog:allow-save",
    "dialog:allow-open",
    "dialog:allow-message",
    "dialog:allow-ask",
    "dialog:allow-confirm",
    "allow-api-call",
    "allow-mcp-http-status",
    "allow-mcp-http-apply",
    "allow-biometric-status",
    "allow-unlock-biometric",
    "allow-fido2-present",
    "allow-fido2-register",
    "allow-fido2-unlock",
    "allow-downloads-read",
    "allow-downloads-trash",
    "allow-open-external",
    "allow-system-notify",
    "allow-quit-app",
    "allow-read-qr-native",
    "allow-read-barcode-native",
    "allow-read-payment-codes-native",
    "allow-read-text-native",
    "allow-sefaz-open",
    "allow-sefaz-capture",
    "allow-secret-copy",
    "allow-secure-input",
    "allow-update-status",
    "allow-update-check",
    "allow-update-install",
    "allow-translation-status",
    "allow-translate-text",
    "core:window:allow-set-content-protected"
  ]
}
