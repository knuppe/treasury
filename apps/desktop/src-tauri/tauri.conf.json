{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Treasury",
  "mainBinaryName": "treasury",
  "version": "1.0.0",
  "identifier": "io.github.knuppe.treasury",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Treasury",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true,
        "backgroundColor": "#070b0f",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'none'",
      "freezePrototype": false
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "appimage", "deb", "rpm", "msi", "nsis"],
    "category": "Finance",
    "publisher": "Knuppe",
    "shortDescription": "Family finances and investments, local-first and encrypted",
    "longDescription": "Family finances and investments in one encrypted vault on your computer, with an optional AI agent that only proposes changes for you to approve.",
    "copyright": "© 2026 Knuppe",
    "license": "AGPL-3.0-only",
    "licenseFile": "../../../LICENSE",
    "resources": {
      "../../../THIRD_PARTY_LICENSES.md": "THIRD_PARTY_LICENSES.md",
      "../../../DATA_LICENSES.md": "DATA_LICENSES.md",
      "../../../NOTICE": "NOTICE"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "wix": { "upgradeCode": "ad8c365b-e907-52d7-a04b-2eba3d10fb89" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR", "English", "Spanish"]
      }
    },
    "linux": {
      "deb": { "depends": [] }
    }
  }
}
