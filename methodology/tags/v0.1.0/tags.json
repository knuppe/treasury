{
  "version": "0.1.0",
  "note": "Características calculadas com os indicadores do universo (dados públicos da CVM, B3 e SEC). Cada tag é um retrato do dado, não uma recomendação. Uma tag com várias regras vale pela regra da classe do papel; as condições de uma regra valem todas juntas.",
  "tags": [
    {"key": "nunca_prejuizo", "group": "historico", "rules": [{"classes": ["stock_br", "stock_us"], "all": [
